{
  "name": "focuskept",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "build": "next build && pnpm build:migrations && pnpm build:worker",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node scripts/local.mjs e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "email:inbox": "node --env-file=.env.local scripts/email-inbox.mjs",
    "build:migrations": "esbuild scripts/migrate.mjs --bundle --platform=node --format=cjs --external:pg-native --outfile=.migration-runner.cjs",
    "setup": "node scripts/setup.mjs",
    "local:up": "node scripts/local.mjs up",
    "local:stop": "node scripts/local.mjs stop",
    "local:logs": "node scripts/local.mjs logs",
    "local:migrate": "node scripts/local.mjs migrate",
    "local:test-db": "node scripts/local.mjs test-db",
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "node scripts/build-worker.mjs && node --env-file-if-exists=.env.local --enable-source-maps .worker.cjs",
    "worker:once": "node scripts/build-worker.mjs && node --env-file-if-exists=.env.local .worker.cjs --once",
    "spdx": "node scripts/spdx.mjs",
    "spdx:check": "node scripts/spdx.mjs --check"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.8",
    "@date-fns/tz": "1.5.0",
    "@polar-sh/sdk": "1.0.2",
    "@radix-ui/react-slot": "1.5.0",
    "@sentry/nextjs": "11.7.0",
    "better-auth": "1.7.8",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "lucide-react": "1.57.0",
    "marked": "18.1.2",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "posthog-js": "1.438.10",
    "posthog-node": "5.56.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.2",
    "resend": "6.33.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "license": "AGPL-3.0-only"
}
