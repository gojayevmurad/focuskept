{
  "name": "focuskept",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A focus timer that helps you remember what you studied.",
  "homepage": "https://focuskept.com",
  "repository": "github:gojayevmurad/focuskept",
  "scripts": {
    "dev": "node scripts/fonts.mjs && node scripts/local.mjs dev",
    "build": "node scripts/fonts.mjs && next build && pnpm build:migrations",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node scripts/local.mjs e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "email:inbox": "node --env-file=.env.local scripts/email-inbox.mjs",
    "build:migrations": "esbuild scripts/migrate.mjs --bundle --platform=node --format=cjs --external:pg-native --outfile=.migration-runner.cjs",
    "setup": "node scripts/setup.mjs",
    "local:up": "node scripts/local.mjs up",
    "local:stop": "node scripts/local.mjs stop",
    "local:logs": "node scripts/local.mjs logs",
    "local:migrate": "node scripts/local.mjs migrate",
    "local:test-db": "node scripts/local.mjs test-db",
    "i18n:check": "node scripts/i18n-check.mjs",
    "dev:seed": "node scripts/dev-seed.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.8",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@polar-sh/sdk": "1.0.2",
    "@radix-ui/react-slot": "1.5.0",
    "@sentry/nextjs": "11.7.0",
    "better-auth": "1.7.8",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "openai": "7.27.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "posthog-js": "1.438.10",
    "posthog-node": "5.56.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.2",
    "resend": "6.33.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.18",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
