# pnpm setup generates private per-project values from this template.
# Do not copy development credentials into production.
# Drizzle loads .env.local when available; exported values take precedence.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to sandbox. Configure a Pro custom benefit on ALL paid products.
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_MONTHLY_PRODUCT_ID=
POLAR_YEARLY_PRODUCT_ID=
POLAR_LIFETIME_PRODUCT_ID=
POLAR_PRO_BENEFIT_ID=
# Preview emails are stored locally in PostgreSQL; never sent.
EMAIL_MODE=preview
EMAIL_FROM=Starter <onboarding@resend.dev>
RESEND_API_KEY=
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_RELEASE=
# Public values are baked into the client bundle at build time.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
# Build-only source-map upload credentials. Never pass as Docker ARG.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Isolated database only. Name MUST end in _test.
TEST_DATABASE_URL=postgres://starter:starter@localhost:5433/starter_test

# Local runtime default. Set NODE_ENV=production in production runtime.env.
NODE_ENV=development
# Branding and access.
APP_NAME=FocusKept
LOGO_URL=
SUPPORT_EMAIL=
BILLING_ENABLED=false
ANALYTICS_ENABLED=false
MARKETING_ENABLED=true
SIGNUPS_MODE=open
ADMIN_EMAILS=
# Session limits and host perks.
FREE_WEEKLY_SESSIONS=3
HOST_PERK_SESSIONS=8
HOST_MIN_SESSIONS=10
# cloudflare in production, livekit for self-hosting, none for local dev only.
VIDEO_PROVIDER=none
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_TOKEN=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=
VIDEO_USAGE_ALERT_GB=800
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Search engines and AI search (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
# Comma separated public profile URLs (X, LinkedIn, GitHub...) for structured data
SOCIAL_PROFILES=
# Operator details for the legal notice page (optional)
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_REGISTRATION=
SECURITY_CONTACT=
