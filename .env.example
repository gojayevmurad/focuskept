# `pnpm setup` generates .env.local from this file.
# Do not copy development credentials into production.
# Drizzle loads .env.local when available; exported values take precedence.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://focuskept:focuskept@localhost:5432/focuskept
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to sandbox. Configure a Pro custom benefit on ALL paid products.
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_MONTHLY_PRODUCT_ID=
POLAR_YEARLY_PRODUCT_ID=
POLAR_LIFETIME_PRODUCT_ID=
POLAR_PRO_BENEFIT_ID=
# Preview emails are stored locally in PostgreSQL; never sent.
EMAIL_MODE=preview
EMAIL_FROM=FocusKept <onboarding@resend.dev>
RESEND_API_KEY=
# Reminder/report sender (auth emails keep EMAIL_FROM).
REMINDER_EMAIL_FROM=FocusKept <reminders@focuskept.com>
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_RELEASE=
# staging | production (defaults to NODE_ENV). The browser derives it from the host.
SENTRY_ENVIRONMENT=
# AI (OpenAI). Off until a key is set; the UI then offers manual questions.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=30000
# Pro fair-use cap: AI card analyses per calendar month.
PRO_MONTHLY_AI_CARDS=300
# Global daily token kill switch (input + output). Empty = no cap.
AI_DAILY_TOKEN_BUDGET=
# Bearer secret for /api/cron/* (scheduler service). Generate: openssl rand -hex 32
CRON_SECRET=
# Web push (VAPID). Generate: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@focuskept.com
# Public values are baked into the client bundle at build time.
# Canonical public origin for SEO metadata; defaults to https://<domain> from saas.config.json.
NEXT_PUBLIC_SITE_URL=
# Search console ownership tags (optional): Google, Bing (msvalidate.01), Yandex.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
# Build-only source-map upload credentials. Never pass as Docker ARG.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Isolated database only. Name MUST end in _test.
TEST_DATABASE_URL=postgres://focuskept:focuskept@localhost:5433/focuskept_test
